# ─────────────────────────────────────────────────────────────────────────────
# GMCS Compliance Dashboard — Environment Variables
#
# For LOCAL development:
#   Copy this file to .env and fill in values (optional — local uses file storage)
#
# For VERCEL deployment:
#   Add these in Vercel Dashboard → Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Vercel Blob Storage token (required for Vercel deployment only)
# Get this from: Vercel Dashboard → Storage → Blob → Create Store → Get Token
# Local dev does NOT need this — it uses ./data/dashboard-data.json instead
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Optional: custom port for local server (default: 3000)
# PORT=3000
